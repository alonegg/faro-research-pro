# Faro Research Pro — copy to .env and fill in.

# ── Provider (same env keys as OSS Faro Research) ────────────────────
FARO_PROVIDER=openai_compat
FARO_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
FARO_OPENAI_API_KEY=
FARO_OPENAI_MODEL=MiniMax-M2.7

# ── Data sources ─────────────────────────────────────────────────────
TUSHARE_TOKEN=

# ── Server / storage ─────────────────────────────────────────────────
FARO_DB_PATH=./data/faro.db
FARO_CORS_ORIGINS=http://localhost:5174

# ── Auth (optional; leave unset for single-tenant) ──────────────────
# FARO_AUTH_REQUIRED=1
# FARO_ADMIN_KEY=fr-...                # bootstrap admin on cold start
# FARO_AUTH_SECRET=                     # HMAC secret for hashing API keys

# ── Pro brand customisation (all optional) ──────────────────────────
# FARO_PRO_BRAND_NAME=My Research Desk
# FARO_PRO_BRAND_TAGLINE=Quant team daily
# FARO_PRO_BRAND_URL=https://your-org.com/research
# FARO_PRO_BRAND_AUTHOR=Quant Research
# FARO_PRO_BRAND_ACCENT=#4a6cf7
# FARO_PRO_BRAND_ACCENT_DARK=#7a3cf3
# FARO_PRO_CONFIDENTIAL=1               # adds CONFIDENTIAL banner on cover

# ── Agent loop ──────────────────────────────────────────────────────
FARO_MAX_TOOL_TURNS=8
FARO_TOOL_RESULT_MAX_CHARS=3500
FARO_LLM_TIMEOUT_SEC=180
