# Faro Research Pro backend — multi-agent orchestrator + branded PDF.
FROM python:3.12-slim

WORKDIR /app

# System deps for [server,export]:
#   - gcc / pkg-config: needed by xhtml2pdf → pycairo build
#   - libcairo2-dev / libpango1.0-dev: pycairo runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential pkg-config libcairo2-dev libpango1.0-dev \
        git \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY faro_research_pro ./faro_research_pro

# OSS faro-research isn't on PyPI yet; install from GitHub first (with its
# server+export extras), then install Pro on top with --no-deps so pip
# doesn't try to re-resolve faro-research from PyPI.
RUN pip install --no-cache-dir \
        "faro-research[server,export] @ git+https://github.com/alonegg/faro-research.git@main" \
 && pip install --no-cache-dir --no-deps -e ".[server]" \
 && pip install --no-cache-dir xhtml2pdf httpx

# Persisted state lands here (mounted as volume in compose)
RUN mkdir -p /app/data
ENV FARO_DB_PATH=/app/data/faro.db

EXPOSE 8000
CMD ["uvicorn", "faro_research_pro.server:app", "--host", "0.0.0.0", "--port", "8000"]
