# Copy to `.env` on the VPS and fill in real values.
# DO NOT commit .env (it's gitignored).

# ───────── Domain / HTTPS (used by Caddy) ─────────
FARO_DOMAIN=faro.example.com
FARO_ADMIN_EMAIL=you@example.com

# ───────── Auth ─────────
# Set this to a long random string; the holder of this key gets the admin role.
# Generate one: openssl rand -base64 32 | tr -d '+/=' | cut -c1-40
FARO_AUTH_REQUIRED=1
FARO_ADMIN_KEY=fr-admin-CHANGE-ME-USE-openssl-rand-base64-32

# ───────── LLM (main, for research) ─────────
FARO_PROVIDER=openai_compat
FARO_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
FARO_OPENAI_API_KEY=YOUR-MAIN-MODEL-KEY-HERE
FARO_OPENAI_MODEL=MiniMax-M2.7
FARO_LLM_TIMEOUT_SEC=180

# ───────── LLM (small, for titles / summaries) ─────────
FARO_PRO_SMALL_LLM_BASE_URL=
FARO_PRO_SMALL_LLM_API_KEY=
FARO_PRO_SMALL_LLM_MODEL=

# ───────── Data sources ─────────
TUSHARE_TOKEN=YOUR-TUSHARE-TOKEN
FINANCIAL_DATASETS_API_KEY=YOUR-FD-AI-KEY

# ───────── Storage ─────────
FARO_DB_PATH=/app/data/faro.db
FARO_MAX_TOOL_TURNS=8
FARO_TOOL_RESULT_MAX_CHARS=3500
